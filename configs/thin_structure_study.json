{
  "study": "thin-structure diagnostic, phase 1",
  "preregistration": "report/thin_structure_preregistration.md",
  "locked_files": [
    "configs/thin_structure_study.json",
    "report/thin_structure_preregistration.md",
    "scripts/thin_structure_study.py",
    "src/thin_structures.py",
    "report/checkpoint_manifest.json"
  ],
  "phantom": {
    "generator": "src.thin_structures.line_phantom",
    "grid_size": 64,
    "geometries": ["straight", "curved"],
    "core_widths_px": [0, 1, 2, 4, 6],
    "edge_sigmas_px": [0, 0.5, 1, 1.5, 2],
    "excluded_cells": [[0, 0]]
  },
  "test_set": {
    "seed_offset": 600000,
    "n_images": 50,
    "same_phantoms_for_all_cells_and_sensor_counts": true,
    "long_line_subset_min_chord_px": 6.0
  },
  "evaluation": {
    "noise_label": "high",
    "relative_noise_std": 0.2,
    "noise_seed": 979000,
    "sensor_counts": [16, 64],
    "primary_sensor_count": 64,
    "groups": {"control": "mixed160", "intervention": "edgefill160"},
    "network_seeds": [0, 1, 2, 3, 4],
    "checkpoint_dir": "experiments/unrolled_mixed",
    "checkpoint_manifest": "report/checkpoint_manifest.json",
    "tikhonov_mu": {"16": 0.01, "64": 0.01},
    "tikhonov_mu_source": "report/mixed_phantom_results.json, tikhonov_weights_selected_on_mixed160, noise level high"
  },
  "bootstrap": {"n_boot": 2000, "level": 0.95, "seed": 0},
  "cells": {
    "thin": [0, 1],
    "thick_same_edge": [6, 1],
    "secondary_width_contrasts": [
      {"thick": [6, 0.5], "thin": [1, 0.5]},
      {"thick": [6, 1.5], "thin": [0, 1.5]}
    ],
    "thin_soft_set": [[0, 1], [0, 1.5], [1, 0.5], [1, 1]],
    "edge_sweep_core_width": 6,
    "valley_edge_sigmas": [0.5, 1],
    "smooth_edge_sigma": 2,
    "paired_edge_sigma": 1,
    "edge_range_sigmas": [0.5, 1, 1.5, 2],
    "sharp_thin_bar": [1, 0],
    "sharp_familiar_bars": [[4, 0], [6, 0]]
  },
  "thresholds_db": {
    "material_effect": 3.0,
    "negligible_effect": 1.0,
    "geometry_tolerance": 1.0,
    "interaction_flag": 2.0
  },
  "outputs": [
    "report/thin_structure_results.json",
    "report/thin_structure_results.txt",
    "report/thin_structure_per_image.npz",
    "report/thin_structure_results.png"
  ]
}
